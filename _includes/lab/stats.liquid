{% comment %}
  Publication stats (Publications page). Citations and h-index come from _data/citations.yml,
  which the update-citations workflow refreshes from Google Scholar. The paper count is
  filled in from papers.bib by lab-filter.js.
{% endcomment %}
{% assign total_cites = 0 %}
{% assign cites = '' | split: '' %}
{% for p in site.data.citations.papers %}
  {% assign c = p[1].citations | plus: 0 %}
  {% assign total_cites = total_cites | plus: c %}
  {% assign cites = cites | push: c %}
{% endfor %}
{% assign cites = cites | sort | reverse %}
{% assign h_index = 0 %}
{% for c in cites %}
  {% if c >= forloop.index %}{% assign h_index = forloop.index %}{% endif %}
{% endfor %}
<div class="lab-stats">
  <div>
    <strong data-stat="pubs">{{ site.data.citations.papers | size }}</strong><span>Publications</span>
  </div>
  <div>
    <strong>{{ total_cites }}</strong><span>Citations</span>
  </div>
  <div>
    <strong>{{ h_index }}</strong><span>h-index</span>
  </div>
  {% for s in site.data.lab.extra_stats %}
    <div>
      <strong>{{ s.value }}</strong><span>{{ s.label }}</span>
    </div>
  {% endfor %}
</div>
{% if site.data.citations.metadata.last_updated %}
  <p class="lab-muted lab-stats-note">
    Citation data from
    <a href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}" target="_blank" rel="noopener">Google Scholar</a>,
    updated {{ site.data.citations.metadata.last_updated | date: '%b %-d, %Y' }}.
  </p>
{% endif %}
